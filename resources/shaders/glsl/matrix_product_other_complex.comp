// Vulkan/GLSL compute shader
// author: Christian Suer (github: 'cyberchriz')

#version 450

// setup specialization constants
// in "main" use gl_WorkGroupSize.x / gl_WorkGroupSize.y / gl_WorkGroupSize.z to get the actual workgroup size
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

// setup buffers
layout(set = 0, binding = 0) buffer first_real_buffer {float first_real[];};
layout(set = 0, binding = 1) buffer first_imag_buffer {float first_imag[];};
layout(set = 0, binding = 2) buffer second_real_buffer {float second_real[];};
layout(set = 0, binding = 3) buffer second_imag_buffer {float second_imag[];};
layout(set = 0, binding = 4) buffer result_real_buffer {float result_real[];};
layout(set = 0, binding = 5) buffer result_imag_buffer {float result_imag[];};

// setup push constants layout
layout(push_constant) uniform push_constants {
    uint first_N;
    uint first_rows;
    uint first_cols;
    uint second_N;
    uint second_rows;
    uint second_cols;
    uint result_N;
    uint result_rows;
    uint result_cols;
};

// main function
void main() {
    uint col = gl_GlobalInvocationID.x % result_cols; // column index
    uint row = gl_GlobalInvocationID.x / result_cols; // row index

    // Ensure we don't go out of bounds for the result matrix
    if (row >= result_rows || col >= result_cols) {
        return;
    }

    // Initialize the real and imaginary sums for the result element
    float sum_real = 0.0;
    float sum_imag = 0.0;

    // The matrix product C = A * B is defined as C_ij = sum(A_ik * B_kj)
    // For complex numbers, (a+bi)(c+di) = (ac-bd) + (ad+bc)i
    for (uint k = 0; k < first_cols; ++k) {
        // Calculate flat indices for the input arrays
        uint first_index = row * first_cols + k;
        uint second_index = k * second_cols + col;

        // Perform bounds checking for the input arrays
        if (first_index < first_N && second_index < second_N) {
            // Get the real and imaginary parts of the current elements being multiplied
            float a = first_real[first_index];
            float b = first_imag[first_index];
            float c = second_real[second_index];
            float d = second_imag[second_index];

            // Perform complex multiplication and add to the running sums
            sum_real += (a * c) - (b * d);
            sum_imag += (a * d) + (b * c);
        }
    }

    // Calculate the flat index for the result matrix
    uint result_index = row * result_cols + col;

    // Perform bounds checking for the result arrays and write the sums
    if (result_index < result_N) {
        // Ensure -0.0 is written as 0.0
        result_real[result_index] = (sum_real == 0.0) ? 0.0 : sum_real;
        result_imag[result_index] = (sum_imag == 0.0) ? 0.0 : sum_imag;
    }

    memoryBarrierBuffer(); barrier();
}
