// Vulkan/GLSL compute shader: COLLISION CONFIRMATION
// author: Christian Suer (github: 'cyberchriz')

#version 450

#define EPSILON 1e-6f

// setup specialization constants
// in "main" use gl_WorkGroupSize.x / gl_WorkGroupSize.y / gl_WorkGroupSize.z to get the actual workgroup size
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

// ==========================
// GPU-side data structures
// ==========================

struct PhysicsState {
    mat4 model_matrix;
    mat4 inv_model_matrix;
    mat4 rot_inv_inertia;

    vec4 orientation;
    
    vec4 mesh_bbox_min;
    vec4 mesh_bbox_max;
    vec4 world_bbox_min;
    vec4 world_bbox_max;
    vec4 world_bbox_center;
    vec4 world_bbox_axes[3];

    vec4 scale;
    vec4 pos;
    vec4 lin_vel;
    vec4 gravity;
    vec4 lin_thrust;
    vec4 spin_vel;
    vec4 spin_thrust;
    vec4 scale_vel;
    vec4 scale_acc;
    vec4 mesh_local_cog;
    vec4 world_cog;

    int unique_entity_ID;
    int unique_mesh_ID;
    int last_collided_with;
    int lin_enabled;

    int rot_enabled;
    int solid;
    uint voxel_master_buffer_offset;
    uint voxel_buffer_elements;

    float mesh_base_mass_kg;
    float scaled_mass_kg;
    float inv_scaled_mass_kg;
    float restitution;

    float friction;
    float drag_coeff;
    float tumble_strength;
    float rho;

    float mesh_fill_ratio;
    float length_unit;
    int lin_impulse_x;	    // accumulators for atomicAdd
	int	lin_impulse_y;	    // ""

	int	lin_impulse_z;	    // ""
	int	spin_impulse_x;	    // ""
	int	spin_impulse_y;	    // ""
	int	spin_impulse_z;	    // ""

	int pos_impulse_x;		// accumulators for atomic Baumgarte positional correction
	int pos_impulse_y;		// ""
	int pos_impulse_z;		// ""
	int protection_flag;    // 0 = false; 1 = the user has made updates to the state since the last physics snapshot
};

struct EntitySortKey {
    float x_min;
    uint entID; // note: this is NOT the same as the global unique_entity_ID, but rather the index into the states buffer (which is used for sorting) !!!
};

struct CollisionCandidate {
	uint entID_A;
	uint entID_B;
};

struct CollisionResult {
    vec4 normal;  // for storing the final results after averaing (resolution step 1)
    vec4 contact; // ""

    int normal_sum_x;
    int normal_sum_y;
    int normal_sum_z;
    uint hit_count;

    int contact_x;
    int contact_y;
    int contact_z;
    int is_complex_collision; // 0 for simple AABB (SAT), 1 for complex voxel-based collision
    
    int entID_A;
	int entID_B;   
    float overlap;
    int padding;
};

// ==========================
// Buffers
// ==========================
layout(set = 0, binding = 0, std430) buffer states_buffer { PhysicsState states[]; };
layout(set = 0, binding = 1) buffer sort_keys_buffer { EntitySortKey sort_keys[]; };
layout(set = 0, binding = 2) buffer voxel_master_buffer { uint voxels[]; };
layout(set = 0, binding = 3, std430) buffer collision_candidates_buffer { CollisionCandidate candidates[]; };
layout(set = 0, binding = 4) buffer collision_candidates_count_buffer { uint candidates_count[]; }; // single element buffer to hold the count of candidates, incremented atomically
layout(set = 0, binding = 5, std430) buffer collision_results_buffer { CollisionResult results[]; };

// ==========================
// Push constants
// ==========================
layout(push_constant) uniform push_constants {
    uint states_count;
    uint vb_res;
    float dt_substep;
    uint max_collisions_per_substep;
    float complex_threshold; // size threshold to determine if we should do voxel-based collision or just flag as simple (SAT)
    uint solver_iterations;
    uint sort_stage; // 0 = even, 1 = odd
} pc;

uint voxel_buffer_elements = pc.vb_res * pc.vb_res * pc.vb_res;

// ==========================
// Helpers
// ==========================

bool GET_VOXEL_BIT(uint master_offset, uint x, uint y, uint z) {
    uint idx = x + (y * pc.vb_res) + (z * pc.vb_res * pc.vb_res);
    uint global_bit_idx = master_offset + idx;
    return (voxels[global_bit_idx / 32] & (1u << (global_bit_idx % 32))) != 0;
}

// ==========================
// Shared Memory
// ==========================
shared uint shared_cand_count;

void main() {
    uvec3 voxB = gl_GlobalInvocationID.xyz;
    
    if (voxB.x >= pc.vb_res || voxB.y >= pc.vb_res || voxB.z >= pc.vb_res) return;

    // Use shared memory to fetch the candidate count once per workgroup
    if (gl_LocalInvocationIndex == 0) {
        shared_cand_count = candidates_count[0];
    }
    barrier();

    uint cand_limit = min(shared_cand_count, pc.max_collisions_per_substep);

    // Iterate through candidates
    for (uint c = 0; c < cand_limit; ++c) {
        
        // Only proceed if this pair was marked for complex (voxel) check in Detection phase
        if (results[c].is_complex_collision == 0) continue;

        CollisionCandidate pair = candidates[c];
        PhysicsState sA = states[pair.entID_A];
        PhysicsState sB = states[pair.entID_B];

        // 1. Check if the current voxel 'voxB' is active in object B
        if (GET_VOXEL_BIT(sB.voxel_master_buffer_offset, voxB.x, voxB.y, voxB.z)) {
            
            // Convert voxel B index to local space coordinate
            vec3 normB = (vec3(voxB) + 0.5) / float(pc.vb_res);
            vec3 localPosB = sB.mesh_bbox_min.xyz + normB * (sB.mesh_bbox_max.xyz - sB.mesh_bbox_min.xyz);
            
            // Transform point to World Space
            vec4 worldPos = sB.model_matrix * vec4(localPosB, 1.0);
            
            // Transform world point to A's Local Space
            vec4 localPosA4 = sA.inv_model_matrix * worldPos;
            vec3 localPosA = localPosA4.xyz;
            
            // Normalize into [0, 1] range of A's mesh bounding box
            vec3 normA = (localPosA - sA.mesh_bbox_min.xyz) / (sA.mesh_bbox_max.xyz - sA.mesh_bbox_min.xyz);

            // 2. Check if the point is within A's local volume
            if (all(greaterThanEqual(normA, vec3(0.0))) && all(lessThanEqual(normA, vec3(1.0)))) {
                uvec3 voxIdxA = uvec3(normA * float(pc.vb_res));
                
                // Ensure the calculated index doesn't overshoot due to float precision
                voxIdxA = min(voxIdxA, uvec3(pc.vb_res - 1));

                // 3. Voxel-to-Voxel intersection check
                if (GET_VOXEL_BIT(sA.voxel_master_buffer_offset, voxIdxA.x, voxIdxA.y, voxIdxA.z)) {
                    
                    // Found a contact point! Increment hit count
                    atomicAdd(results[c].hit_count, 1);
    
                    // Accumulate contact position using fixed-point (int) to avoid atomic float issues
                    atomicAdd(results[c].contact_x, int(worldPos.x * 1000.0f));
                    atomicAdd(results[c].contact_y, int(worldPos.y * 1000.0f));
                    atomicAdd(results[c].contact_z, int(worldPos.z * 1000.0f));

                    // Normal calculation: Direction from A's center to the impact point
                    vec3 normal = normalize(worldPos.xyz - sA.world_cog.xyz);
    
                    // Accumulate normal for averaging in the Resolver step
                    atomicAdd(results[c].normal_sum_x, int(normal.x * 1000.0f));
                    atomicAdd(results[c].normal_sum_y, int(normal.y * 1000.0f));
                    atomicAdd(results[c].normal_sum_z, int(normal.z * 1000.0f));
                }
            }
        }
    }
}