#version 450

// setup specialization constants
// in "main" use gl_WorkGroupSize.x / gl_WorkGroupSize.y / gl_WorkGroupSize.z to get the actual workgroup size
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

// ==========================
// GPU-side data structures
// ==========================

struct CollisionCandidateGPU {
    mat4 modelB;
    mat4 invModelA;
    vec4 bbox_A_min;
    vec4 bbox_B_min;
    vec4 bbox_A_range;
    vec4 bbox_B_range;
    vec4 collision_normal;
    uint voxel_buffer_A_offset;
    uint voxel_buffer_B_offset;
    int entID_A;
	int entID_B;
};

struct CollisionResultGPU {
    uint hit_count;
    int contact_x;
    int contact_y;
    int contact_z;
};

// ==========================
// Buffers
// ==========================
layout(std430, binding = 0) readonly buffer VoxelMasterBuffer { uint mask[]; };
layout(std430, binding = 1) readonly buffer CandidatesBuffer { CollisionCandidateGPU candidates[]; };
layout(std430, binding = 2) buffer ResultBuffer { CollisionResultGPU results[]; };

// ==========================
// Push constants
// ==========================
layout(push_constant) uniform PushConstants {
    uint candidates_count;
    uint voxel_buffer_elements;
    uint resolution;
} pc;

// ==========================
// Helpers
// ==========================
#define IS_SOLID(idx) ((mask[(idx) >> 5] & (1u << ((idx) & 31u))) != 0u)

int clamp_i32_from_float(float v) {
    if (v > float(0x7fffffff)) return 0x7fffffff;
    if (v < float(-0x7fffffff)) return -0x7fffffff;
    return int(v);
}

// ==========================
// Workgroup shared memory
// ==========================
shared uint local_hit_count;
shared ivec3 local_contact_sum;

// ==========================
// Main
// ==========================

void main() {
    uvec3 pos = gl_GlobalInvocationID;

    if (pos.x >= pc.resolution ||
        pos.y >= pc.resolution ||
        pos.z >= pc.resolution)
        return;

    for (uint c = 0; c < pc.candidates_count; ++c) {

        // Initialize shared accumulators once per workgroup per candidate
        if (gl_LocalInvocationIndex == 0) {
            local_hit_count = 0u;
            local_contact_sum = ivec3(0);
        }
        barrier();

        uint idxB =
            pos.x +
            pos.y * pc.resolution +
            pos.z * pc.resolution * pc.resolution +
            candidates[c].voxel_buffer_B_offset;

        if (!IS_SOLID(idxB)) {
            barrier();
            continue;
        }

        // Voxel center ? normalized [0..1]
        vec3 normalizedB = (vec3(pos) + 0.5) / float(pc.resolution);

        // B local ? world
        vec3 localPosB = candidates[c].bbox_B_min.xyz + normalizedB * candidates[c].bbox_B_range.xyz;
        vec3 worldPos = (candidates[c].modelB * vec4(localPosB, 1.0)).xyz;

        // world ? A local
        vec3 localPosA = (candidates[c].invModelA * vec4(worldPos, 1.0)).xyz;

        vec3 rangeA = max(candidates[c].bbox_A_range.xyz, vec3(1e-4));
        vec3 normalizedA = (localPosA - candidates[c].bbox_A_min.xyz) / rangeA;

        const float eps = 0.01;

        if (all(greaterThanEqual(normalizedA, vec3(-eps))) &&
            all(lessThanEqual(normalizedA, vec3(1.0 + eps)))) {

            vec3 scaledA = normalizedA * float(pc.resolution);
            uvec3 voxelA = uvec3(clamp(scaledA, vec3(0.0), vec3(float(pc.resolution - 1))));

            uint idxA =
                voxelA.x +
                voxelA.y * pc.resolution +
                voxelA.z * pc.resolution * pc.resolution +
                candidates[c].voxel_buffer_A_offset;

            if (IS_SOLID(idxA)) {
                atomicAdd(local_hit_count, 1u);
                atomicAdd(local_contact_sum.x, clamp_i32_from_float(worldPos.x * 1000.0));
                atomicAdd(local_contact_sum.y, clamp_i32_from_float(worldPos.y * 1000.0));
                atomicAdd(local_contact_sum.z, clamp_i32_from_float(worldPos.z * 1000.0));
            }
        }

        barrier();

        // One atomic write per workgroup
        if (gl_LocalInvocationIndex == 0 && local_hit_count > 0u) {
            atomicAdd(results[c].hit_count, local_hit_count);
            atomicAdd(results[c].contact_x, local_contact_sum.x);
            atomicAdd(results[c].contact_y, local_contact_sum.y);
            atomicAdd(results[c].contact_z, local_contact_sum.z);
        }

        barrier();
    }
}
